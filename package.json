{
  "name": "atanor",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build:engine": "node scripts/build-engine.js",
    "postinstall": "node scripts/build-engine.js",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:apk": "eas build -p android --profile preview",
    "test:engine": "python3 tests/make_fixtures.py /tmp/fx && node scripts/build-engine.js && node -e \"const s=require('fs').readFileSync('src/engineHtml.js','utf8').replace(/^export default /,'').replace(/;\\\\s*$/,'');require('fs').writeFileSync('/tmp/engine.html',JSON.parse(s))\" && python3 tests/engine_test.py /tmp/engine.html /tmp/fx"
  },
  "dependencies": {
    "expo": "^58.0.0",
    "react": "*",
    "react-native": "*",
    "react-native-webview": "*",
    "react-native-svg": "*",
    "react-native-safe-area-context": "*",
    "expo-document-picker": "*",
    "expo-file-system": "*",
    "expo-font": "*",
    "expo-localization": "*",
    "expo-sharing": "*",
    "@react-native-async-storage/async-storage": "*",
    "lucide-react-native": "*",
    "@expo-google-fonts/cinzel": "*",
    "@expo-google-fonts/cinzel-decorative": "*",
    "@expo-google-fonts/inter": "*",
    "@expo-google-fonts/jetbrains-mono": "*",
    "jszip": "3.10.1",
    "pdfjs-dist": "3.11.174"
  }
}